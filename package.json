{
  "name": "moneymap",
  "private": true,
  "version": "1.0.0",
  "description": "MoneyMap — intelligent financial product matching & decision platform (Zenith Bank Zecathon 6.0, Challenge #9 prototype)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:embed": "tsc -b && VITE_ROUTER=memory vite build --outDir dist-embed && node scripts/bundle-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "qa": "node scripts/qa.mjs",
    "start": "node --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch --import tsx server/index.ts",
    "build:server-app": "tsc -b && VITE_API_MODE=http vite build",
    "typecheck:server": "tsc --noEmit -p server",
    "smoke": "node scripts/smoke.mjs",
    "mock:zenith": "node --disable-warning=ExperimentalWarning --import tsx server/mockZenith.ts",
    "links": "node scripts/check-links.mjs",
    "brand": "node scripts/brand.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.5",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.10.2",
    "playwright": "^1.56.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
